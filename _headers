/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/krishna-fast-*
  Cache-Control: public, max-age=31536000, immutable
/krishna-poster-*
  Cache-Control: public, max-age=31536000, immutable
/viewer-*
  Cache-Control: public, max-age=31536000, immutable
/chunk-*
  Cache-Control: public, max-age=31536000, immutable
